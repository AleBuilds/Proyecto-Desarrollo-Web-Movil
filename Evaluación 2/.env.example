# Plantilla de configuración. Copie a .env (o deje que scripts\iniciar-todo.ps1 lo genere
# con valores aleatorios). El archivo .env NO se versiona ni se entrega.
INTERNAL_SERVICE_SECRET=<generar-con-scripts/iniciar-todo.ps1>
AUTH_INTROSPECTION_SECRET=<generar-con-scripts/iniciar-todo.ps1>
PAYMENTS_SERVICE_SECRET=<generar-con-scripts/iniciar-todo.ps1>
GRPC_SERVICE_SECRET=<generar-con-scripts/iniciar-todo.ps1>
SESSION_TTL=900
COOKIE_SECURE=false
RATE_LIMIT_GENERAL_POR_MIN=120
RATE_LIMIT_LOGIN_POR_MIN=5
